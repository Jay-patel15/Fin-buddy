# Copy to .env and fill in real values for local development.
# In production, set the same names in Vercel → Project → Settings → Environment Variables.
# .env is git-ignored — never commit real secrets.

# --- Google Sheets backend (Apps Script Web App) ---
# Web app URL from script.google.com → Deploy → New deployment → Web app
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Same string you set as SHARED_SECRET inside the Apps Script source
APPS_SCRIPT_SECRET=replace-me-with-a-long-random-string

# --- JWT signing key for session cookies ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: cookie name (default fb_session) and lifetime in days (default 7)
# COOKIE_NAME=fb_session
# COOKIE_DAYS=7
